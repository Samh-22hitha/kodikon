# Keep this key server-side. The browser only receives the negotiated WebRTC session.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
LIVEAVATAR_API_KEY=
LIVEAVATAR_SANDBOX=true
LIVEAVATAR_MAX_SESSION_DURATION=60

# ── LiveAvatar.com Embed API (iframe-based avatar) ──────────────
# Get your API key from liveavatar.com
LIVEAVATAR_EMBED_API_KEY=
LIVEAVATAR_EMBED_AVATAR_ID=65f9e3c9-d48b-4118-b73a-4ae2e3cbb8f0
LIVEAVATAR_EMBED_CONTEXT_ID=
